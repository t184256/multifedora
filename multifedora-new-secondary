#!/usr/bin/env bash
# Install a system under multifedora/NAME. It never becomes the primary.
# The shared ESP and /boot partition stay in place: its boot tree goes to
# /boot/multifedora/NAME/ and an ESP menu entry is added for it.
# ESP stays intact.
# usage: $0 NAME BOOT STREAM MANIFEST

set -Eeuo pipefail

[[ $# -eq 4 ]] || { echo "usage: $0 NAME BOOT STREAM MANIFEST" >&2; exit 2; }

NAME=$1
BOOT_TAR=$2
STREAM=$3
MANIFEST=$4

for t in btrfs mount findmnt tar sed; do
  command -v "$t" >/dev/null || { echo "ERROR: missing $t" >&2; exit 1; }
done

if [[ ! $NAME =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
  echo "ERROR: invalid name: $NAME" >&2
  exit 1
fi

for f in "$BOOT_TAR" "$STREAM" "$MANIFEST"; do
  [[ -f $f ]] || { echo "ERROR: no such file: $f" >&2; exit 1; }
done

BDEV=$(findmnt -no SOURCE -T / | sed 's/\[.*\]//')  # strip [subvol=...]
S0=$(mktemp -d)
mount -o subvolid=5 "$BDEV" "$S0"
cleanup() {
  umount "$S0" || { echo "ERROR: cannot unmount $S0" >&2; exit 1; }
  rm -d "$S0"
}
trap cleanup EXIT
MULTI=$S0/multifedora
[[ -d $MULTI ]] || btrfs subvolume create "$MULTI"

[[ -e $MULTI/$NAME ]] && {
  echo "ERROR: multifedora/$NAME already exists" >&2
  exit 1
}

multifedora-inject "$STREAM" "$MANIFEST" "$MULTI/$NAME"

# the efi/ copy is dead weight: the shared ESP stays in place
mkdir -p "/boot/multifedora/$NAME"
tar xf "$BOOT_TAR" --exclude=./efi -C "/boot/multifedora/$NAME"

multifedora-reseat "$NAME"
multifedora-esp-menu
echo "installed multifedora/$NAME; it appears in the ESP menu now"
