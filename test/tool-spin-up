#!/usr/bin/env bash
# Spin up an installed Fedora image.
# If an optional COMMAND is passed, run it inside the VM over SSH
# and power off afterwards.
# If SHARE_DIR is set, that host directory is mounted at /share.
# If BACKGROUND_PIDFILE is set, exit 0 as soon as SSH is up, leaving the VM
# running and writing its pid to that file. Kill or poweroff it yourself then.
set -Eeuo pipefail

[[ $# -ge 1 ]] || { echo "usage: $0 DISK [COMMAND...]" >&2; exit 2; }
SRC=$1
COMMAND=("${@:2}")
GRUB_DOWN_COUNT=${GRUB_DOWN_COUNT:-0}  # boot Nth entry from the default
SSHPORT=${SSHPORT:-2234}
CPU_CORES=${CPU_CORES:-2}
RAM_GB=${RAM_GB:-4}
DISP=${DISP:-none}  # set to, e.g., vnc=127.0.0.1:0 for debugging
MON=${MON:-4547}
BACKGROUND_PIDFILE=${BACKGROUND_PIDFILE:-}

die() { echo "ERROR: $*" >&2; exit 1; }

if (exec 3<>"/dev/tcp/127.0.0.1/$MON") 2>/dev/null; then
  exec 3>&-
  die "monitor port $MON is busy, wait for the previous QEMU to exit first"
fi

if [[ -n $BACKGROUND_PIDFILE ]] && (( ${#COMMAND[@]} )); then
  die 'BACKGROUND_PIDFILE and COMMAND are mutually exclusive'
fi

# throwaway OVMF copies
CODE=$(mktemp /tmp/test-tool-spin-up-code.XXXX.fd)
VARS=$(mktemp /tmp/test-tool-spin-up-vars.XXXX.fd)
OVMF=${OVMF:-/usr/share/edk2/ovmf}
D=$(dirname "$0")
[[ -f "$D/tmp/ssh-key" ]] || die 'no tmp/ssh-key; install first'
cleanup() {
  rm -f "$CODE" "$VARS"
  [[ -n ${QEMU_PID:-} ]] && kill "$QEMU_PID" 2>/dev/null || true
}
trap cleanup EXIT

cp "$OVMF/OVMF_CODE.fd" "$CODE"
cp "$OVMF/OVMF_VARS.fd" "$VARS"

mon() { printf '%s\n' "$@" | nc -w3 localhost "$MON" >/dev/null; }

probe_ssh() (
  exec 3<>"/dev/tcp/127.0.0.1/$SSHPORT" 2>/dev/null || return 1
  local banner=''
  IFS= read -r -t 1 -u 3 banner || { exec 3>&-; return 1; }
  exec 3>&-
  [[ $banner == SSH-* ]]
)

wait_ssh() {
  local t0=$SECONDS
  while [ $((SECONDS - t0)) -lt 60 ]; do
    if probe_ssh; then return; fi
    sleep .1
  done
  mon 'screendump /tmp/tool-spin-up-fail.png -f png'
  die 'ssh port never came up, see /tmp/tool-spin-up-fail.png'
}

SHARE_ARGS=()
if [[ -n ${SHARE_DIR:-} ]]; then
  [[ -d $SHARE_DIR ]] || die "SHARE_DIR=$SHARE_DIR is not a directory"
  # shellcheck disable=SC2054  # -fsdev takes one comma-separated string
  SHARE_ARGS=(-fsdev "local,id=share,path=$SHARE_DIR,security_model=none" \
              -device virtio-9p-pci,fsdev=share,mount_tag=virtio)
fi

qemu-system-x86_64 \
  -monitor "tcp:localhost:$MON,server,nowait" \
  -machine q35 -cpu host -enable-kvm \
  -smp "$CPU_CORES" \
  -m "${RAM_GB}G" \
  -drive if=pflash,format=raw,unit=0,file="$CODE" \
  -drive if=pflash,format=raw,unit=1,file="$VARS" \
  -display "$DISP" \
  -netdev "user,id=n,hostfwd=tcp:127.0.0.1:$SSHPORT-:22" \
  -device virtio-net-pci,netdev=n \
  "${SHARE_ARGS[@]}" \
  -drive file="$SRC",if=virtio,cache=none,cache.no-flush=on,format=raw \
  -no-reboot &
QEMU_PID=$!
sleep 1
kill -0 "$QEMU_PID" 2>/dev/null || die "qemu died at startup"
echo "qemu up (pid $QEMU_PID), monitor on $MON, waiting for SSH to go up..."

if (( ${GRUB_DOWN_COUNT:-0} )); then
  sleep 3
  for _ in $(seq "$GRUB_DOWN_COUNT"); do mon sendkey down; done
  mon 'sendkey ret'
else
  # spam early enters, hoping to skip the menu countdown(s) on defaults
  sleep 1; mon 'sendkey ret'
  sleep 1; mon 'sendkey ret'
fi

wait_ssh
echo 'ssh port is up...'

if ! "$D/tool-inside-vm" 'echo "SSH works, use test/tool-inside-vm"'; then
  mon 'screendump /tmp/tool-spin-up-fail.png -f png'
  kill "$QEMU_PID" 2>/dev/null
  die 'SSH never went up, see /tmp/tool-spin-up-fail.png'
fi

if [[ -n ${SHARE_DIR:-} ]]; then
  "$D/tool-inside-vm" 'modprobe 9p; mount --mkdir -t 9p virtio /share' \
    || die 'failed to mount the 9p share'
fi

if [[ -n $BACKGROUND_PIDFILE ]]; then
  echo "$QEMU_PID" > "$BACKGROUND_PIDFILE"
  trap 'rm -f "$CODE" "$VARS"' EXIT  # leave qemu running
  echo "qemu (pid $QEMU_PID) left running, pid in $BACKGROUND_PIDFILE"
  exit 0
fi

if (( ${#COMMAND[@]} )); then
  RC=0
  "$D/tool-inside-vm" "${COMMAND[@]}" || RC=$?
  echo "command exited with $RC, powering off..."
  "$D/tool-inside-vm" poweroff >/dev/null 2>&1 || true
  wait "$QEMU_PID" || true
  exit "$RC"
fi

wait "$QEMU_PID"
echo "qemu (pid $QEMU_PID) has exited"
