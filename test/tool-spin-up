#!/usr/bin/env bash
# Spin up an installed Fedora image, fully blind: fixed waits + QEMU monitor
# sendkeys on the VGA console (no serial, no expect, no prompt matching).
#   1. boot DISK (a throwaway copy!) under OVMF+KVM
#   2. type the LUKS passphrase at dracut's prompt (~15s in; it never times out)
#   3. wait for the SSH port, log in as root on tty1
#   4. inject test/tmp/ssh-key.pub via tee, verify ssh works
# If an optional COMMAND is passed, run it inside the VM over SSH
# instead of leaving the VM running.
# If SHARE_DIR is set, that host directory is mounted at /share
set -Eeuo pipefail

[[ $# -ge 1 ]] || { echo "usage: $0 DISK [COMMAND...]" >&2; exit 2; }
SRC=$1
COMMAND=("${@:2}")
LUKS_PASS=${LUKS_PASS:-example}
ROOT_PASS=${ROOT_PASS:-example}
SSHPORT=${SSHPORT:-2234}
CPU_CORES=${CPU_CORES:-2}
RAM_GB=${RAM_GB:-4}
DISP=${DISP:-none}  # set to, e.g., vnc=127.0.0.1:0 for debugging
MON=${MON:-4547}

die() { echo "ERROR: $*" >&2; exit 1; }

# throwaway OVMF copies
CODE=$(mktemp /tmp/test-tool-spin-up-code.XXXX.fd)
VARS=$(mktemp /tmp/test-tool-spin-up-vars.XXXX.fd)
OVMF=${OVMF:-/usr/share/edk2/ovmf}
[[ -f test/tmp/ssh-key ]] || {
  mkdir -p test/tmp
  ssh-keygen -t ed25519 -N '' -C tool-spin-up -f test/tmp/ssh-key -q
}
cleanup() {
  rm -f "$CODE" "$VARS"
  [[ -n ${QEMU_PID:-} ]] && kill "$QEMU_PID" 2>/dev/null || true
}
trap cleanup EXIT

cp "$OVMF/OVMF_CODE.fd" "$CODE"
cp "$OVMF/OVMF_VARS.fd" "$VARS"

mon() { printf '%s\n' "$@" | nc -w3 localhost "$MON" >/dev/null; }
sendchars() {
  local s=$1 c i=0
  while [ $i -lt ${#s} ]; do
    c=${s:i:1}
    case $c in
      [a-z0-9]) echo "sendkey $c" ;;
      [[:upper:]])
                echo "sendkey shift-$(tr '[:upper:]' '[:lower:]' <<<"$c")" ;;
      ' ')      echo 'sendkey spc' ;;
      -)        echo 'sendkey minus' ;;
      /)        echo 'sendkey slash' ;;
      .)        echo 'sendkey dot' ;;
      +)        echo 'sendkey shift-equal' ;;
      _)        echo 'sendkey shift-minus' ;;
      *)        { echo "sendchars: unsupported char '$c'" >&2; return 1; } ;;
    esac
    i=$((i+1))
  done
}
typeline() {
  { sendchars "$1"; echo 'sendkey ret'; } | nc -w3 localhost "$MON" >/dev/null
}

probe_ssh() (
  exec 3<>"/dev/tcp/127.0.0.1/$SSHPORT" 2>/dev/null || return 1
  local banner=''
  IFS= read -r -t 1 -u 3 banner || { exec 3>&-; return 1; }
  exec 3>&-
  [[ $banner == SSH-* ]]
)

wait_ssh() {
  local t0=$SECONDS
  while [ $((SECONDS - t0)) -lt 60 ]; do
    if probe_ssh; then return; fi
    sleep .1
  done
  mon 'screendump /tmp/tool-spin-up-fail.png -f png'
  die 'ssh port never came up, see /tmp/tool-spin-up-fail.png'
}

SHARE_ARGS=()
if [[ -n ${SHARE_DIR:-} ]]; then
  [[ -d $SHARE_DIR ]] || die "SHARE_DIR=$SHARE_DIR is not a directory"
  # shellcheck disable=SC2054  # -fsdev takes one comma-separated string
  SHARE_ARGS=(-fsdev "local,id=share,path=$SHARE_DIR,security_model=none" \
              -device virtio-9p-pci,fsdev=share,mount_tag=virtio)
fi

qemu-system-x86_64 \
  -monitor "tcp:localhost:$MON,server,nowait" \
  -machine q35 -cpu host -enable-kvm \
  -smp "$CPU_CORES" \
  -m "${RAM_GB}G" \
  -drive if=pflash,format=raw,unit=0,file="$CODE" \
  -drive if=pflash,format=raw,unit=1,file="$VARS" \
  -display "$DISP" \
  -netdev "user,id=n,hostfwd=tcp:127.0.0.1:$SSHPORT-:22" \
  -device virtio-net-pci,netdev=n \
  "${SHARE_ARGS[@]}" \
  -drive file="$SRC",if=virtio,format=raw \
  -no-reboot &
QEMU_PID=$!
sleep 1
kill -0 "$QEMU_PID" 2>/dev/null || die "qemu died at startup"
echo "qemu up (pid $QEMU_PID), monitor on $MON, try SSH'ing in in ~a minute..."

# nudge GRUB: early enters, hoping to skip the menu countdown
sleep 2; mon 'sendkey ret'
sleep 2; mon 'sendkey ret'
sleep 10  # the LUKS prompt appears ~10s in
typeline "$LUKS_PASS"

wait_ssh
echo 'ssh port is up...'
sleep 5
echo 'logging in interactively...'
typeline root
sleep .5
typeline "$ROOT_PASS"
sleep 1

echo 'configuring SSH...'
typeline 'mkdir -p /root/.ssh'
typeline 'tee /root/.ssh/authorized_keys'
{ sendchars "ssh-ed25519 $(cut -d' ' -f2 test/tmp/ssh-key.pub)"; echo 'sendkey ret'; } \
  | nc -w3 localhost "$MON" >/dev/null
sleep 0.25
mon 'sendkey ctrl-d'

if ! test/tool-inside-vm 'echo "SSH works, use ./test/tool-inside-vm"'; then
  mon 'screendump /tmp/tool-spin-up-fail.png -f png'
  kill "$QEMU_PID" 2>/dev/null
  die 'SSH never went up, see /tmp/tool-spin-up-fail.png'
fi

if [[ -n ${SHARE_DIR:-} ]]; then
  test/tool-inside-vm 'modprobe 9p; mount --mkdir -t 9p virtio /share' \
    || die 'failed to mount the 9p share'
fi

if (( ${#COMMAND[@]} )); then
  RC=0
  test/tool-inside-vm "${COMMAND[@]}" || RC=$?
  echo "command exited with $RC, powering off..."
  test/tool-inside-vm poweroff >/dev/null 2>&1 || true
  wait "$QEMU_PID" || true
  exit "$RC"
fi

wait "$QEMU_PID"
echo "qemu (pid $QEMU_PID) has exited"
