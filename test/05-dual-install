#!/usr/bin/env bash
# Stage 05: test multifedora-new-secondary on a live system.
# Installs stage 03's artifacts as multifedora/example, pins the entire
# tier-1 ESP menu against a constant, drops marker files into both
# systems for stages 06/07, and checks that a second reseat is a pure
# no-op. On success the image is renamed to tmp/05/dual.img, their
# input. Run from test/.

set -Eeuo pipefail
cd "$(dirname "$0")"

die() { echo "ERROR: $*" >&2; exit 1; }
[[ -f tmp/01/initial.img ]] || die "no tmp/01/initial.img; run stage 01 first"
for f in second.boot.tar second.rootfs second.rootfs.manifest; do
  [[ -s tmp/03/$f ]] || die "no tmp/03/$f; run stage 03 first"
done

WORK=tmp/05/tmp.img
mkdir -p tmp/05
cp --sparse=always tmp/01/initial.img "$WORK"

SHARE=tmp/05/share
rm -rf "$SHARE"
mkdir -p "$SHARE"
cp ../multifedora-new-secondary ../multifedora-list ../multifedora-inject \
   ../multifedora-reseat ../multifedora-esp-menu \
   ../multifedora-chroot-next \
   tmp/03/second.boot.tar tmp/03/second.rootfs \
   tmp/03/second.rootfs.manifest "$SHARE/"
cat > "$SHARE/run.sh" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
cd /share
install -d /usr/libexec/multifedora
install -m755 multifedora-* /usr/libexec/multifedora/
export PATH=/usr/libexec/multifedora:"$PATH"

diff <(multifedora-list) - <<'EXP'
<primary>
EXP

multifedora-new-secondary example \
  /share/second.boot.tar /share/second.rootfs /share/second.rootfs.manifest

diff <(multifedora-list) - <<'EXP'
<primary>
example
EXP

# verify the seated system: namespaced BLS pointing at this disk,
# an initramfs that knows this disk's LUKS, and a menu entry on the ESP
rc=0
BLS=/boot/multifedora/example/loader/entries
grep -q "linux /multifedora/example/vmlinuz" "$BLS"/*.conf \
  || { echo "FAIL: BLS not namespaced" >&2; rc=1; }
grep -q "root=UUID=$(findmnt -no UUID /)" "$BLS"/*.conf \
  || { echo "FAIL: BLS does not point at this disk" >&2; rc=1; }
LUKS=$(sed -n 's/^luks-\([a-f0-9-]*\) .*/\1/p' /etc/crypttab)
# decompress to a file first: grep -q on a pipe would SIGPIPE the
# still-running decompressor, and pipefail reads that as a failure
zstdcat /boot/multifedora/example/initramfs-*.img > /tmp/ir.bin \
  || { echo "FAIL: cannot decompress the initramfs" >&2; rc=1; }
grep -qa "luks-$LUKS" /tmp/ir.bin \
  || { echo "FAIL: initramfs lacks luks-$LUKS" >&2; rc=1; }
# pin the entire tier-1 ESP menu against a constant (modulo the boot
# uuid), and check the EFI/BOOT copy is identical
BUUID=$(findmnt -no UUID -T /boot)
expfile=$(mktemp)
sed "s/@BUUID@/$BUUID/" > "$expfile" <<'EXP'
# generated by multifedora; do not edit
set timeout_style=menu
set timeout=10
search --no-floppy --root-dev-only --fs-uuid --set=dev @BUUID@
menuentry '[primary]' {
  set prefix=($dev)/grub2
  configfile $prefix/grub.cfg
}
menuentry 'example' {
  set prefix=($dev)/multifedora/example/grub2
  configfile $prefix/grub.cfg
}
EXP
diff "$expfile" /boot/efi/EFI/fedora/grub.cfg \
  || { echo "FAIL: ESP menu drifted from the expected text" >&2; rc=1; }
rm -f "$expfile"
cmp -s /boot/efi/EFI/fedora/grub.cfg /boot/efi/EFI/BOOT/grub.cfg \
  || { echo "FAIL: EFI/BOOT copy differs from EFI/fedora" >&2; rc=1; }

# marker files let stages 06/07 tell which system booted
echo primary > /etc/multifedora-marker
S0=$(mktemp -d)
mount -o subvolid=5 "$(findmnt -no SOURCE / | sed 's/\[.*\]//')" "$S0"
echo example > "$S0/multifedora/example/root/etc/multifedora-marker"
umount "$S0"; rm -rf "$S0"

# idempotency: a second reseat must change nothing
snap() {
  local d=$1 s0
  s0=$(mktemp -d)
  mount -o subvolid=5 "$(findmnt -no SOURCE / | sed 's/\[.*\]//')" "$s0"
  mkdir "$d"
  cp "$BLS"/*.conf /boot/multifedora/example/grub2/grub.cfg \
     "$s0/multifedora/example/root/etc/fstab" \
     "$s0/multifedora/example/root/etc/crypttab" "$d"/
  umount "$s0"; rm -rf "$s0"
}
snap /tmp/pass1
multifedora-reseat example
snap /tmp/pass2
diff -r /tmp/pass1 /tmp/pass2 \
  || { echo "FAIL: reseat is not idempotent" >&2; rc=1; }
exit $rc
EOF
chmod +x "$SHARE/run.sh"

# the install and its verification happen during this boot
SHARE_DIR=$PWD/$SHARE ./tool-spin-up "$WORK" '/share/run.sh'
# success: rename to the persistent artifact (stages 06/07's input); a
# failed run leaves tmp.img behind, so make re-runs the stage
mv "$WORK" tmp/05/dual.img
