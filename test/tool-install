#!/usr/bin/env bash
# Install Fedora unattended. Just an example I'm using for testing.

set -Eeuo pipefail

[[ $# -eq 2 ]] || { echo "usage: $0 ISO DISK" >&2; exit 2; }

command -v qemu-system-x86_64 nc mkksiso ssh-keygen >/dev/null

ISO=$1
DISK=$2
DISK_GB=${DISK_GB:-16G}  # if file does not exist
CPU_CORES=${CPU_CORES:-2}
RAM_GB=${RAM_GB:-4}
DISP=${DISP:-none}  # set to, e.g., vnc=127.0.0.1:0 for debugging, or just
                    # echo 'screendump screen.png -f png' | nc localhost 4545
MON=${MON:-4545}
TIMEOUT_MIN=${TIMEOUT_MIN:-30}  # on my system it takes ~5 minutes

D=$(dirname "$0")
SSH_KEY=$D/tmp/ssh-key
if [[ ! -e $SSH_KEY ]]; then
  mkdir -p "$D/tmp"
  ssh-keygen -t ed25519 -N '' -C tool-install -f "$SSH_KEY" -q
fi

# kickstart with the public key embedded; it gets baked into a throwaway
# ISO copy by mkksiso further down (along with inst.profile)
KS=$D/tmp/initial.ks
sed "s|@PUBKEY@|$(cat "$SSH_KEY.pub")|" > "$KS" <<'EOF'
cdrom  # required: install
cmdline  # required: text mode
# required: storage. --pbkdf-time saves a second of boot time
autopart --encrypted --passphrase=example --type=btrfs --pbkdf-time=100
network --hostname=example  # -net none, hostname only
rootpw example
sshkey --username root "@PUBKEY@"

%packages --exclude-weakdeps
@core --nodefaults
openssh-server
tar
-audit  # not -audit*: audit-libs is required by util-linux/openssh/shadow-utils
-chrony
-dracut-config-rescue
-firewalld
-fwupd
-glibc-gconv-extra.x86_64
-iproute
-iputils
-langpacks-en
-libbpf
-libmnl
-lvm2
-man-db
-ncurses
-plymouth*
-prefixdevname
-sssd-*
-vim-minimal
glibc-minimal-langpack
%end

%post
UUID=$(blkid -s UUID -o value -t TYPE=crypto_LUKS)
echo -n 'example' > /etc/luks-key
chmod 600 /etc/luks-key
echo "luks-$UUID UUID=$UUID /etc/luks-key discard,x-initrd.attach" \
    > /etc/crypttab
install -d /etc/dracut.conf.d
echo 'install_optional_items+=" /etc/luks-key "' \
    > /etc/dracut.conf.d/99lukskey.conf
dracut --force
%end

poweroff
EOF

DISK_FRESH=0
if [[ ! -f "$DISK" ]]; then
  qemu-img create -f raw "$DISK" "$DISK_GB"
  DISK_FRESH=1
fi
parted -s "$DISK" mklabel gpt  # autopart ignores it otherwise for some reason

# throwaway OVMF copies
CODE=$(mktemp /tmp/fedora-install-code.XXXX.fd)
VARS=$(mktemp /tmp/fedora-install-vars.XXXX.fd)
OVMF=${OVMF:-/usr/share/edk2/ovmf}
cp "$OVMF/OVMF_CODE.fd" "$CODE"
cp "$OVMF/OVMF_VARS.fd" "$VARS"
trap 'rm -f "$CODE" "$VARS"' EXIT

# embed the kickstart and select the workstation profile
# so that autopart follows the workstation partitioning (root + home subvolumes)
ISO_PATCHED=$(mktemp -u fedora-install-iso.XXXX)  # do not pre-create
mkksiso --no-md5sum -c "inst.profile=fedora-workstation" --ks "$KS" \
        "$ISO" "$ISO_PATCHED"
(
  # try to save ~50s on GRUB screen
  sleep 5; nc localhost "$MON" <<<$'sendkey up\nsendkey ret' >/dev/null
  sleep 55
  for ((i = TIMEOUT_MIN - 1; i > 1; i--)); do
    msg="  $i minutes until timeout"
    (( DISK_FRESH )) && msg+=", $(du -sm "$DISK" | cut -f1)M written so far"
    echo "$msg..."
    (( i > 2 )) && sleep 1m
  done
)&
BACKGROUND=$!
trap 'kill $BACKGROUND 2>/dev/null; rm -f "$CODE" "$VARS" "$ISO_PATCHED"' EXIT

echo "Installing $ISO to $DISK with a timeout of $TIMEOUT_MIN minutes..."
timeout "${TIMEOUT_MIN}m" qemu-system-x86_64 \
  -monitor "tcp:localhost:$MON,server,nowait" \
  -machine q35 -cpu host -enable-kvm \
  -smp "$CPU_CORES" \
  -m "${RAM_GB}G" \
  -drive if=pflash,format=raw,unit=0,file="$CODE" \
  -drive if=pflash,format=raw,unit=1,file="$VARS" \
  -display "$DISP" \
  -device qemu-xhci,id=cdbus -device usb-storage,bus=cdbus.0,drive=iso \
  -drive file="$ISO_PATCHED",if=none,id=iso,format=raw,readonly=on \
  -drive file="$DISK",if=virtio,cache=none,cache.no-flush=on,format=raw \
  -net none \
  -no-reboot
echo "QEMU completed, $ISO might be installed into $DISK."
