#!/usr/bin/env bash
set -Eeuo pipefail

[[ $# -eq 2 ]] || { echo "usage: $0 ISO DISK" >&2; exit 2; }
KS=$1
OUT=$2
[ -f "$KS" ] || { echo "error: no such kickstart file: $KS" >&2; exit 1; }

command -v guestfish >/dev/null

# 72 MiB keeps the FAT32 above the 65525-cluster spec minimum
truncate -s 72M "$OUT"
guestfish <<EOF
add "$OUT"
run
part-init /dev/sda mbr
part-add /dev/sda p 2048 -1
mkfs vfat /dev/sda1
set-label /dev/sda1 OEMDRV
mount /dev/sda1 /
upload "$KS" /ks.cfg
umount-all
EOF
