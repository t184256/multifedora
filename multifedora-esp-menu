#!/usr/bin/env bash
# Regenerate the top ESP menu with:
# * the primary system entry
# * one entry per each system under /boot/multifedora/
# Each entry chains into that system's own /boot's /grub2/grub.cfg,
# which keeps its normal kernel menu.
# usage: $0 [ESP_DIR] [BOOT_DIR]  (defaults to /boot/efi and /boot)
#        $0 ESP_DIR BOOT_DIR BOOT_UUID  (for non-standard paths)

set -Eeuo pipefail

command -v findmnt basename >/dev/null

ESP_DIR=${1:-/boot/efi}
BOOT_DIR=${2:-/boot}
if [[ $# -ge 3 ]]; then
  BOOT_UUID=$3
else
  # -T (not a bare path): BOOT_DIR may be a directory inside the /boot
  # mount, not a mount point itself (e.g. /boot/multifedora/NAME)
  BOOT_UUID=$(findmnt -no UUID -T "$BOOT_DIR")
fi

{
  echo '# generated by multifedora; do not edit'
  echo 'set timeout_style=menu'
  echo 'set timeout=5'
  echo "search --no-floppy --root-dev-only --fs-uuid --set=dev $BOOT_UUID"
  echo "menuentry '[primary]' {"
  echo '  set prefix=($dev)/grub2'  # shellcheck disable=SC2016
  echo '  configfile $prefix/grub.cfg'  # shellcheck disable=SC2016
  echo '}'
  for d in "$BOOT_DIR"/multifedora/*; do
    name=$(basename "$d")
    echo "menuentry '$name' {"
    echo "  set prefix=(\$dev)/multifedora/$name/grub2"
    echo '  configfile $prefix/grub.cfg'  # shellcheck disable=SC2016
    echo '}'
  done
} > "$ESP_DIR/EFI/fedora/grub.cfg"

cp -f "$ESP_DIR/EFI/fedora/grub.cfg" "$ESP_DIR/EFI/BOOT/grub.cfg"
