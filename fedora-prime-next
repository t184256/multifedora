#!/usr/bin/env bash
# Stage the next main system images for the -supplant to switch on shutdown.
set -Eeuo pipefail

[[ $# -eq 3 ]] || { echo "usage: $0 ESP BOOT STREAM " >&2; exit 2; }

command -v btrfs mount findmnt sed >/dev/null

ESP=$1
BOOT=$2
STREAM=$3
for f in "$ESP" "$BOOT" "$STREAM"; do
  [ -f "$f" ] || { echo "ERROR: no such file: $f" >&2; exit 1; }
done

BDEV=$(findmnt -no SOURCE -T / | sed 's/\[.*\]//')  # strip [subvol=...]
S0=$(mktemp -d)
mount -o subvolid=5 "$BDEV" "$S0"
trap 'umount "$S0" 2>/dev/null || true; rm -d "$S0" 2>/dev/null || true' EXIT
MULTI=$S0/multi
[ -d "$MULTI" ] || btrfs subvolume create "$MULTI"

# drop .next
NEXT=$MULTI/.next
[ ! -e "$NEXT" ] || btrfs subvolume delete -R "$NEXT"

# rebuild .next
btrfs subvolume create "$NEXT"
cp "$ESP" "$BOOT" "$NEXT/"
mkdir "$NEXT/subvols"
btrfs receive "$NEXT/subvols" < "$STREAM"

# supplant looks at the .next-supplant-this symlink
# relative target: the link lives in multi/ next to .next, and $S0 is
# gone by the time the supplant follows it
ln -sf .next "$MULTI/.next-supplant-this.tmp"
mv -f -T "$MULTI/.next-supplant-this.tmp" "$MULTI/.next-supplant-this"
