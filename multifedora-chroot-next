#!/usr/bin/env bash
# Run a command in the primed next system (multifedora/.next), always rw.
# A private helper: no parent CLI case.
# usage: $0 --read-write [NSPAWN-OPTS] [COMMAND [ARG...]]

set -Eeuo pipefail

if [[ ${1-} != --read-write ]]; then
  echo "usage: $0 --read-write [NSPAWN-OPTS] [COMMAND [ARG...]]" >&2
  exit 2
fi
shift

if [[ $# -eq 0 ]]; then
  set -- bash
fi

if [[ "$(id -u)" != 0 ]]; then
  echo "ERROR: must run as root" >&2
  exit 1
fi

for t in findmnt sed head mount systemd-nspawn; do
  command -v "$t" >/dev/null || { echo "ERROR: missing $t" >&2; exit 1; }
done

BDEV=$(findmnt -no SOURCE -T / | sed 's/\[.*\]//')  # strip [subvol=...]
S0=$(mktemp -d)
ROOT=''
EXTRA=()
cleanup() {
  if [[ -n $ROOT ]]; then
    for m in "${EXTRA[@]}"; do
      umount "$m" || { echo "ERROR: cannot unmount $m" >&2; exit 1; }
    done
    umount "$ROOT/boot" \
      || { echo "ERROR: cannot unmount $ROOT/boot" >&2; exit 1; }
    umount "$ROOT" || { echo "ERROR: cannot unmount $ROOT" >&2; exit 1; }
    rm -d "$ROOT"
  fi
  umount "$S0" || { echo "ERROR: cannot unmount $S0" >&2; exit 1; }
  rm -d "$S0"
}
trap cleanup EXIT

mount -o subvolid=5 "$BDEV" "$S0"
NEXT=$S0/multifedora/.next
if [[ ! -d $NEXT ]]; then
  echo "ERROR: no primed system (multifedora/.next is missing)" >&2
  exit 1
fi
BOOT=$NEXT/boot
if [[ ! -d $BOOT/loader/entries ]]; then
  echo "ERROR: no boot tree in multifedora/.next" >&2
  exit 1
fi
ROOTSV=$(sed -n 's/.*rootflags=subvol=\([^ ]*\).*/\1/p' \
  "$BOOT"/loader/entries/*.conf | head -1)
if [[ -z $ROOTSV ]]; then
  echo "ERROR: no root subvolume named in the BLS entries" >&2
  exit 1
fi

ROOT=$(mktemp -d /run/mf-next.XXXXXX)
mount -o subvol=multifedora/.next/subvols/"$ROOTSV" "$BDEV" "$ROOT"
mount --bind "$BOOT" "$ROOT/boot"

# can't mount the entire fstab, since it's seated for primary;
# differs from other chroots in that =/
# mount at least the .next/subvols/ subvolumes we're aware of
DISK_UUID=$(findmnt -no UUID "$BDEV" | head -1)
while read -r dev mnt fstype opts _rest; do
  [[ $mnt != / ]] || continue
  if [[ $fstype == btrfs && $dev == "UUID=$DISK_UUID" ]]; then
    sv=$(sed -n 's/.*subvol=\([^ ,]*\).*/\1/p' <<<"$opts")
    if [[ -n $sv ]]; then
      mkdir -p "$ROOT$mnt"
      mount -o subvol="multifedora/.next/subvols/$sv" "$BDEV" "$ROOT$mnt"
      EXTRA+=("$ROOT$mnt")
    fi
  fi
done < "$ROOT/etc/fstab"

NSPAWN=(systemd-nspawn -q --machine=next -D "$ROOT")
[[ -t 0 ]] || NSPAWN+=(--console=pipe)  # don't allocate pty if non-interactive
"${NSPAWN[@]}" "$@"
