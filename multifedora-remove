#!/usr/bin/env bash
# Remove a multifedora/NAME system: its subvolumes, its boot tree,
# under /boot/multifedora/, and its tier-1 menu entry. Frees the space.
# usage: $0 NAME

set -Eeuo pipefail

[[ $# -eq 1 ]] || { echo "usage: $0 NAME" >&2; exit 2; }

DIR=$(dirname "$(readlink -f "$0")")
export PATH="$DIR:$PATH"

command -v btrfs mount findmnt readlink >/dev/null

NAME=$1

BDEV=$(findmnt -no SOURCE -T / | sed 's/\[.*\]//')  # strip [subvol=...]
S0=$(mktemp -d)
mount -o subvolid=5 "$BDEV" "$S0"
cleanup() {
  umount "$S0" || { echo "ERROR: cannot unmount $S0" >&2; exit 1; }
  rm -d "$S0"
}
trap cleanup EXIT
MULTI=$S0/multifedora

[[ -d $MULTI/$NAME ]] || {
  echo "ERROR: no such system: multifedora/$NAME" >&2
  exit 1
}

# $MULTI/$NAME is a plain directory of subvolumes
for sv in $(btrfs subvolume list "$S0" | \
            grep -E " path multifedora/$NAME/[^/ ]+$" | sed 's/.*path //'); do
  btrfs subvolume delete -R "$S0/$sv"
done
rm -d "$MULTI/$NAME"
# the boot tree of the removed system (a plain directory on /boot);
# it may be absent if the system was injected but never fully installed
if [[ -d /boot/multifedora/$NAME ]]; then
  rm -r "/boot/multifedora/$NAME"
fi
multifedora-esp-menu
echo "removed multifedora/$NAME"
