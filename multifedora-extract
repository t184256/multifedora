#!/usr/bin/env bash
# Extract data from an installed Fedora disk image with a default btrfs layout:
# GPT(ESP(vfat), /boot(ext4), p3=LUKS(btrfs(root, home, ...)).
# Writes:
#   OUT_ESP_TAR          tarball of the ESP partition contents
#   OUT_BOOT_TAR         tarball of the /boot partition contents
#   OUT_ROOTFS           all rootfs btrfs subvolumes stream, named after IDs
#   OUT_ROOTFS.manifest  one line per subvolume, in restore order: id path ro|rw

set -Eeuo pipefail

if [[ $# -ne 5 ]]; then
  echo \
    "usage: $0 IMG LUKS_PASSPHRASE OUT_ESP_TAR OUT_BOOT_TAR OUT_ROOT_BTRFS" >&2
  exit 2
fi

command -v losetup blkid mount tar cryptsetup btrfs >/dev/null

IMG=$1
LUKS_PASSPHRASE=$2
OUT_ESP_TAR=$3
OUT_BOOT_TAR=$4
OUT_ROOT_BTRFS=$5

cryptsetup close fedroot 2>/dev/null || true

LO=$(losetup --find --show --partscan "$IMG")
TMP=$(mktemp -d)
SNAPS=()
cleanup() {
  for sv in "${SNAPS[@]}"; do
    btrfs subvolume delete "$TMP/$sv" 2>/dev/null || true
  done
  umount "$TMP" 2>/dev/null || true
  cryptsetup close fedroot 2>/dev/null || true
  losetup -d "$LO" 2>/dev/null || true
  rm -d "$TMP" 2>/dev/null || true
}
trap cleanup EXIT

[[ $(blkid -s TYPE -o value "${LO}"p{1,2,3}) == $'vfat\next4\ncrypto_LUKS' ]]
[[ ! -e "${LO}p4" ]] || exit 1

mount -o ro "${LO}p1" "$TMP"; tar -C "$TMP" -cf "$OUT_ESP_TAR" .; umount "$TMP"
mount -o ro "${LO}p2" "$TMP"; tar -C "$TMP" -cf "$OUT_BOOT_TAR" .; umount "$TMP"

echo -n "$LUKS_PASSPHRASE" | cryptsetup open --key-file=- "${LO}p3" fedroot
mount -o subvolid=5 /dev/mapper/fedroot "$TMP"

# btrfs send only records each subvolume's basenames in the stream,
# then receive extracts them flat with no hierarchy, so name them after IDs.
LINES=()
while read -r _f1 id _f2 _gen _f3 _lvl _parent _f8 path; do
  # btrfs-progs prints "ro: false" (old) or "ro=false" (new)
  if [[ $(btrfs property get "$TMP/$path" ro) == *false* ]]; then
    flag=rw
  else
    flag=ro
  fi
  LINES+=("$path $id $flag")
done < <(btrfs subvolume list "$TMP")

printf '%s\n' "${LINES[@]}" | LC_ALL=C sort > "$OUT_ROOT_BTRFS.manifest"

while read -r path id flag; do
  btrfs subvolume snapshot -r "$TMP/$path" "$TMP/$id"
  SNAPS+=("$id")
done < "$OUT_ROOT_BTRFS.manifest"
btrfs send -e --proto 0 --compressed-data \
  -f "$OUT_ROOT_BTRFS" "${SNAPS[@]/#/$TMP/}"
for sv in "${SNAPS[@]}"; do btrfs subvolume delete "$TMP/$sv"; done
umount "$TMP"

echo -n 'extracted: '
echo "$OUT_ESP_TAR $OUT_BOOT_TAR $OUT_ROOT_BTRFS $OUT_ROOT_BTRFS.manifest"
