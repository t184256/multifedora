#!/usr/bin/env bash
# multifedora: manage secondary systems under multifedora/.
# usage: $0 add SECONDARY_NAME IMAGE    install a system from a disk image
#        $0 remove SECONDARY            delete a system and free its space
#        $0 prime-pivot OLD_NAME IMAGE  at the next shutdown, make the
#                                       image the primary system and
#                                       stash the running one as OLD_NAME

set -Eeuo pipefail

# resolve symlinks: we are installed as /usr/sbin/multifedora -> libexec
DIR=$(dirname "$(readlink -f "$0")")
# the helpers call each other by bare name
export PATH="$DIR:$PATH"
USAGE="usage: $0 COMMAND

  add SECONDARY_NAME IMAGE        install a system from a disk image
  remove SECONDARY                delete a system and free its space
  prime-pivot OLD_NAME IMAGE      at the next shutdown, make the image
                                  the primary system and stash the running
                                  one as a secondary one under OLD_NAME
  chroot MODE TARGET [OPTS] CMD   run a command in a secondary or image
  chroot-secondary MODE NAME ...  run a command in a secondary system
  chroot-image MODE IMAGE ...     run a command in a disk image"

[[ $# -ge 1 ]] || { echo "$USAGE" >&2; exit 2; }

case $1 in
add)
  [[ $# -eq 3 ]] || { echo "usage: $0 add SECONDARY_NAME IMAGE" >&2; exit 2; }
  NAME=$2
  IMAGE=$3
  [[ -f $IMAGE ]] || { echo "ERROR: no such image: $IMAGE" >&2; exit 1; }

  # passphrase: env, a command that prints it (image path as $1), or prompt
  if [[ -z ${LUKS_PASSPHRASE-} && -n ${LUKS_PASSPHRASE_COMMAND-} ]]; then
    LUKS_PASSPHRASE=$(sh -c "$LUKS_PASSPHRASE_COMMAND" "$IMAGE")
  elif [[ -z ${LUKS_PASSPHRASE-} ]]; then
    [[ -t 0 ]] || {
      echo "ERROR: no LUKS_PASSPHRASE and no tty to prompt on" >&2
      exit 1
    }
    read -rs -p "LUKS passphrase for $IMAGE: " LUKS_PASSPHRASE
    echo
  fi

  TMP=$(mktemp -d)
  trap 'rm -rf "$TMP"' EXIT
  # the ESP tar is not needed: this machine's ESP stays in place
  "$DIR/multifedora-extract" "$IMAGE" "$LUKS_PASSPHRASE" \
    "$TMP/esp.tar" "$TMP/boot.tar" "$TMP/rootfs"
  "$DIR/multifedora-new-secondary" "$NAME" \
    "$TMP/boot.tar" "$TMP/rootfs" "$TMP/rootfs.manifest"
  ;;
remove)
  [[ $# -eq 2 ]] || { echo "usage: $0 remove SECONDARY" >&2; exit 2; }
  "$DIR/multifedora-remove" "$2"
  ;;
prime-pivot)
  [[ $# -eq 3 ]] || { echo "usage: $0 prime-pivot OLD_NAME IMAGE" >&2; exit 2; }
  NAME=$2
  IMAGE=$3
  [[ -f $IMAGE ]] || { echo "ERROR: no such image: $IMAGE" >&2; exit 1; }

  # passphrase: env, a command that prints it (image path as $1), or prompt
  if [[ -z ${LUKS_PASSPHRASE-} && -n ${LUKS_PASSPHRASE_COMMAND-} ]]; then
    LUKS_PASSPHRASE=$(sh -c "$LUKS_PASSPHRASE_COMMAND" "$IMAGE")
  elif [[ -z ${LUKS_PASSPHRASE-} ]]; then
    [[ -t 0 ]] || {
      echo "ERROR: no LUKS_PASSPHRASE and no tty to prompt on" >&2
      exit 1
    }
    read -rs -p "LUKS passphrase for $IMAGE: " LUKS_PASSPHRASE
    echo
  fi

  TMP=$(mktemp -d)
  trap 'rm -rf "$TMP"' EXIT
  "$DIR/multifedora-extract" "$IMAGE" "$LUKS_PASSPHRASE" \
    "$TMP/esp.tar" "$TMP/boot.tar" "$TMP/rootfs"
  "$DIR/multifedora-prime-yield" "$NAME" \
    "$TMP/esp.tar" "$TMP/boot.tar" "$TMP/rootfs" "$TMP/rootfs.manifest"
  ;;
chroot)
  [[ $# -ge 3 ]] || {
    echo "usage: $0 chroot --read-only|--read-write" \
         "TARGET [OPTS] CMD [ARGS...]" >&2
    exit 2
  }
  shift
  if [[ ! -x $DIR/multifedora-chroot ]]; then
    echo "ERROR: chroot commands not found; install the" \
         "multifedora-chroot package" >&2
    exit 1
  fi
  exec "$DIR/multifedora-chroot" "$@"
  ;;
chroot-secondary)
  [[ $# -ge 3 ]] || {
    echo "usage: $0 chroot-secondary --read-only|--read-write" \
         "NAME [OPTS] CMD [ARGS...]" >&2
    exit 2
  }
  shift
  if [[ ! -x $DIR/multifedora-chroot-secondary ]]; then
    echo "ERROR: chroot commands not found; install the" \
         "multifedora-chroot package" >&2
    exit 1
  fi
  exec "$DIR/multifedora-chroot-secondary" "$@"
  ;;
chroot-image)
  [[ $# -ge 3 ]] || {
    echo "usage: $0 chroot-image --read-only|--read-write" \
         "IMAGE [OPTS] CMD [ARGS...]" >&2
    exit 2
  }
  shift
  if [[ ! -x $DIR/multifedora-chroot-image ]]; then
    echo "ERROR: chroot commands not found; install the" \
         "multifedora-chroot package" >&2
    exit 1
  fi
  exec "$DIR/multifedora-chroot-image" "$@"
  ;;
*)
  echo "$USAGE" >&2
  exit 2
  ;;
esac
