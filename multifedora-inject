#!/usr/bin/env bash
# Inverse of multifedora-extract: inject a multifedora rootfs stream back
# into a btrfs filesystem, with names and ro flag according to the manifest.

set -Eeuo pipefail

[[ $# -eq 3 ]] || { echo "usage: $0 STREAM MANIFEST DEST" >&2; exit 2; }

command -v btrfs >/dev/null

STREAM=$1
MANIFEST=$2
DEST=$3
for f in "$STREAM" "$MANIFEST"; do
  [[ -f $f ]] || { echo "ERROR: no such file: $f" >&2; exit 1; }
done

mkdir -p "$DEST"
btrfs -q receive "$DEST" < "$STREAM"
# reshuffle into the original hierarchy using the manifest,
# parents come before children, clear ro before move
while read -r path id flag; do
  btrfs property set -f "$DEST/$id" ro false
  if [[ $path == */* ]]; then
    mkdir -p "$DEST/${path%/*}"
  fi
  mv "$DEST/$id" "$DEST/$path"
done < "$MANIFEST"

# (re-)apply intended ro state
while read -r path id flag; do
  if [[ $flag == ro ]]; then
    btrfs property set "$DEST/$path" ro true
  fi
done < "$MANIFEST"
